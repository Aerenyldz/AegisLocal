# Copy to infra/docker/.env before starting Compose.
# Use a long, unique value outside local development.
REDIS_PASSWORD=replace-with-a-long-random-password
AEGIS_CHALLENGE_TOKEN_SECRET=replace-with-a-long-random-secret
AEGIS_API_KEY=replace-with-a-long-random-api-key
AEGIS_API_KEY_REQUIRED=true
AEGIS_TRUST_PROXY_HEADERS=false
AEGIS_TRUSTED_PROXY_IPS=
AEGIS_ONNX_MODEL_PATH=
AEGIS_ONNX_MODEL_VERSION=onnx-unconfigured
AEGIS_ONNX_SHADOW_ENABLED=true
AEGIS_API_BIND=127.0.0.1
AEGIS_API_PORT=8000
